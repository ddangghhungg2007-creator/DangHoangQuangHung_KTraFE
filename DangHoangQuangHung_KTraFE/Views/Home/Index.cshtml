@{
    ViewBag.Title = "Shopping";
}

<!DOCTYPE html>
<html lang="vi">
<head>

    <script src="~/Scripts/MyJS/Java.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Giỏ Hàng - ADC</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #eaeded;
            color: #0f1111;
        }

        /* Header Navbar */
        .navbar {
            background-color: #131921;
            color: white;
            display: flex;
            align-items: center;
            padding: 10px 20px;
            gap: 20px;
        }

        .logo-text {
            font-size: 24px;
            font-weight: bold;
            color: #ff9900;
        }

        .nav-search {
            flex: 1;
            display: flex;
        }

            .nav-search input {
                width: 100%;
                padding: 8px 10px;
                border: none;
                border-radius: 4px 0 0 4px;
            }

            .nav-search button {
                background-color: #febd69;
                border: none;
                padding: 8px 15px;
                border-radius: 0 4px 4px 0;
                cursor: pointer;
            }

        .nav-cart {
            display: flex;
            align-items: center;
            cursor: pointer;
        }

        .cart-icon-wrapper {
            position: relative;
            display: inline-block;
        }

        .cart-badge {
            position: absolute;
            top: -5px;
            right: 5px;
            color: #f08804;
            font-weight: bold;
            font-size: 16px;
        }

        .cart-label {
            margin-left: 8px;
            font-weight: bold;
        }

        /* Main Layout */
        .main-container {
            display: flex;
            max-width: 1400px;
            margin: 20px auto;
            padding: 0 15px;
            gap: 20px;
        }

        .cart-section {
            flex: 3;
            background: white;
            padding: 20px;
            border-radius: 4px;
        }

        .checkout-section {
            flex: 1;
        }

  
        .cart-header {
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
            position: relative;
        }

            .cart-header h2 {
                font-size: 28px;
                font-weight: 400;
            }

        .deselect-all {
            color: #007185;
            text-decoration: none;
            font-size: 13px;
        }

        .price-header {
            position: absolute;
            right: 0;
            bottom: 10px;
            color: #565959;
            font-size: 14px;
        }

        .cart-item {
            display: flex;
            padding: 15px 0;
            border-bottom: 1px solid #ddd;
            gap: 15px;
        }

        .item-image img {
            width: 120px;
            height: 120px;
            object-fit: contain;
        }

        .item-details {
            flex: 1;
        }

            .item-details h3 {
                font-size: 16px;
                color: #0f1111;
                margin-bottom: 5px;
            }

        .stock-status {
            color: #007600;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .shipping-info, .item-attr {
            color: #565959;
            font-size: 12px;
            margin-bottom: 8px;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 10px;
        }

        .btn-qty {
            width: 25px;
            height: 25px;
            background-color: #f0f2f2;
            border: 1px solid #d5d9d9;
            border-radius: 4px;
            cursor: pointer;
        }

        .qty-input {
            width: 40px;
            text-align: center;
            padding: 2px;
            border: 1px solid #d5d9d9;
            border-radius: 4px;
        }

        .action-link {
            color: #007185;
            font-size: 12px;
            margin-left: 15px;
            cursor: pointer;
        }

            .action-link:hover {
                text-decoration: underline;
            }

        .item-price {
            font-size: 18px;
            font-weight: bold;
            text-align: right;
        }

        .cart-footer-subtotal {
            text-align: right;
            padding-top: 15px;
            font-size: 18px;
        }

  
        .checkout-card {
            background: white;
            padding: 20px;
            border-radius: 4px;
        }

        .subtotal-text {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .gift-option {
            font-size: 14px;
            margin-bottom: 15px;
        }

        .btn-proceed {
            width: 100%;
            background-color: #ffd814;
            border: 1px solid #fcd200;
            padding: 10px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
        }

            .btn-proceed:hover {
                background-color: #f7ca00;
            }
    </style>
</head>
<body>

    
    <header class="navbar">
        <div class="nav-logo">
            <span class="logo-text">ADC</span>
        </div>
        <div class="nav-search">
            <input type="text" placeholder="Search Amazon">
            <button><i class="fas fa-search"></i></button>
        </div>
        <div class="nav-cart">
            <div class="cart-icon-wrapper">
                <i class="fas fa-shopping-cart fa-2x"></i>
                <span id="cart-count" class="cart-badge">6</span>
            </div>
            <span class="cart-label">Cart</span>
        </div>
    </header>

    
    <div class="main-container">
        
        <div class="cart-section">
            <div class="cart-header">
                <h2>Shopping Cart</h2>
                <a href="#" class="deselect-all">Deselect all items</a>
                <span class="price-header">Price</span>
            </div>

         
            <div class="cart-item" data-price="44.00">
                <div class="item-checkbox">
                    <input type="checkbox" checked class="item-select">
                </div>
                <div class="item-image">
                    <img src="~/Content/HinhAnh/images.jpg" alt="Tommy Hilfiger Bag">
                </div>
                <div class="item-details">
                    <h3>Tommy Hilfiger Women's Leather Saddle Shoulder Bag</h3>
                    <p class="stock-status">In Stock</p>
                    <p class="shipping-info">FREE International Returns</p>
                    <div class="quantity-control">
                        <label>Qty:</label>
                        <button class="btn-qty btn-minus">-</button>
                        <input type="number" class="qty-input" value="1" min="0">
                        <button class="btn-qty btn-plus">+</button>
                        <span class="action-link btn-delete">Delete</span>
                    </div>
                </div>
                <div class="item-price">
                    $<span class="item-total-price">44.00</span>
                </div>
            </div>

           
            <div class="cart-item" data-price="98.00">
                <div class="item-checkbox">
                    <input type="checkbox" checked class="item-select">
                </div>
                <div class="item-image">
                    <img src="~/Content/HinhAnh/images (1).jpg" alt="Sam Edelman Pump">
                </div>
                <div class="item-details">
                    <h3>Sam Edelman Women's Rosa Pump, Cape Blue, 10</h3>
                    <p class="stock-status">In Stock</p>
                    <p class="item-attr">Size: 10 | Color: Cape Blue</p>
                    <div class="quantity-control">
                        <label>Qty:</label>
                        <button class="btn-qty btn-minus">-</button>
                        <input type="number" class="qty-input" value="2" min="0">
                        <button class="btn-qty btn-plus">+</button>
                        <span class="action-link btn-delete">Delete</span>
                    </div>
                </div>
                <div class="item-price">
                    $<span class="item-total-price">196.00</span>
                </div>
            </div>

        
            <div class="cart-item" data-price="23.00">
                <div class="item-checkbox">
                    <input type="checkbox" checked class="item-select">
                </div>
                <div class="item-image">
                    <img src="~/Content/HinhAnh/vn-11134207-7r98o-lr2pwqde0cd5f6.jpg" alt="Casual Tops">
                </div>
                <div class="item-details">
                    <h3>Newchoice Dressy Casual Tops for Women, XL</h3>
                    <p class="stock-status">In Stock</p>
                    <p class="item-attr">Size: X-Large | Color: Sage Green</p>
                    <div class="quantity-control">
                        <label>Qty:</label>
                        <button class="btn-qty btn-minus">-</button>
                        <input type="number" class="qty-input" value="3" min="0">
                        <button class="btn-qty btn-plus">+</button>
                        <span class="action-link btn-delete">Delete</span>
                    </div>
                </div>
                <div class="item-price">
                    $<span class="item-total-price">69.00</span>
                </div>
            </div>

            <div class="cart-footer-subtotal">
                Subtotal (<span class="total-qty-text">6</span> items): <strong>$<span id="subtotal-amount-left">309.00</span></strong>
            </div>
        </div>

      
        <div class="checkout-section">
            <div class="checkout-card">
                <p class="subtotal-text">
                    Subtotal (<span class="total-qty-text">6</span> items): <strong>$<span id="subtotal-amount">309.00</span></strong>
                </p>
                <div class="gift-option">
                    <input type="checkbox" id="gift">
                    <label for="gift">This order contains a gift</label>
                </div>
                <button class="btn-proceed">Proceed to checkout</button>
            </div>
        </div>
    </div>


</body>
</html>
